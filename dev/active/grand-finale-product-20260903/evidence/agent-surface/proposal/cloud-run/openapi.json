{"openapi":"3.1.0","info":{"title":"BidPilot pursuit API","description":"Evidence-first B2G pursuit decisions over the public G2B catalogue, proposal drafting behind the PURSUE gate (POST /proposal, synthetic demo supplier, nothing persisted), plus read-only replay of completed Cortex analyses. Anonymous and read-only; the same policy the BidPilot app applies.","version":"0.1.0"},"paths":{"/healthz":{"get":{"tags":["meta"],"summary":"Healthz","operationId":"healthz_healthz_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Response Healthz Healthz Get"}}}}}}},"/tenders":{"get":{"tags":["tenders"],"summary":"List Tenders","description":"List the public G2B tender catalogue with each deadline judged open or closed.","operationId":"list_tenders","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"items":{"additionalProperties":true,"type":"object"},"type":"array","title":"Response List Tenders"}}}}}}},"/tenders/{notice_number}":{"get":{"tags":["tenders"],"summary":"Get Tender","description":"Return one catalogue row; the reviewed notice carries requirements and provenance.","operationId":"get_tender","parameters":[{"name":"notice_number","in":"path","required":true,"schema":{"type":"string","title":"Notice Number"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"type":"object","additionalProperties":true,"title":"Response Get Tender"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/decide":{"post":{"tags":["decision"],"summary":"Decide","description":"Apply the pursuit policy without inventing evidence.","operationId":"decide","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DecideRequest"}}},"required":true},"responses":{"200":{"description"